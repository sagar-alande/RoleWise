APP_ENV=local
DATABASE_URL=postgresql+psycopg://rolewise:rolewise@postgres:5432/rolewise
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=rolewise-documents
SQS_QUEUE_URL=http://localstack:4566/000000000000/rolewise-tasks

# AI
BEDROCK_ENABLED=false
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Auth (ignored when APP_ENV=local)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local

# Google Sign-In (ignored when NEXT_PUBLIC_APP_ENV=local - the app uses X-Dev-User instead).
# Both values are public identifiers, not secrets - the Google OAuth client secret lives only in
# Secrets Manager, set up once via infra/lib/rolewise-stack.ts, never in this file.
# NEXT_PUBLIC_COGNITO_DOMAIN is the CognitoHostedUiDomain CDK output, e.g.
#   https://rolewise-dev-auth.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
